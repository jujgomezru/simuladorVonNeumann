// Ejemplo mediano de Bigrafos con declaraciones de variables

// Declaraciones de escalares
int x;                   // entero sin inicializar
char initial = 'Z';      // char con valor inicial

// Arreglos y matrices
float A\[3]\[2] = 1.5;     // matriz 3x2 de floats, inicializa A\[0]\[0] = 1.5
int counts\[5] = 0;       // arreglo de 5 enteros, inicia en 0 cada elemento
char labels\[2]\[3];       // matriz 2x3 de chars sin inicializar

// Definición de controles atómicos y compuestos
atomic control Person;    // control atómico
atomic control Room;      // otro control
composite control Building = Person | Room; // control compuesto

// Firma (signature)
signature S = Person: 1, Room: 2;

// Reglas de reacción
enter: Person | Room -> Room;
exit: Room -> Person;

// Bigrafo principal
bigraph city = Building;

